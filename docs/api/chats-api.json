{
  "api_version": "1.0",
  "base_url": "https://api.example.com",
  "api_section": "chat",
  "endpoints": [
    {
      "id": "chat_list_get",
      "method": "GET",
      "path": "/api/v1/chat/list/",
      "description": "Получение списка чатов",
      "notes": [
        "Доступен поиск по username, nickname, first_name, last_name, patronymic и по тексту сообщений",
        "Доступна сортировка по is_favorite и last_activity_at",
        "last_message.files_summary содержит до 3 уникальных MIME-типов"
      ],
      "parameters": {
        "query": [
          {
            "name": "is_active",
            "type": "boolean",
            "description": "Активные чаты"
          },
          {
            "name": "is_blocked",
            "type": "boolean",
            "description": "Заблокированные чаты"
          },
          {
            "name": "is_favorite",
            "type": "boolean",
            "description": "Избранные чаты"
          },
          {
            "name": "ordering",
            "type": "string",
            "description": "Поле для сортировки результатов"
          },
          {
            "name": "page",
            "type": "integer",
            "description": "Номер страницы"
          },
          {
            "name": "page_size",
            "type": "integer",
            "description": "Количество результатов на странице"
          },
          {
            "name": "search",
            "type": "string",
            "description": "Поисковый запрос"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Успешный ответ",
          "content_type": "application/json",
          "schema": {
            "count": "integer",
            "next": "string (url)",
            "previous": "string (url)",
            "results": "array[ChatListItem]"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "414": {
          "description": "Размер query-параметра превышает лимит"
        }
      }
    },
    {
      "id": "chat_list_update",
      "method": "POST",
      "path": "/api/v1/chat/list/{id}/",
      "description": "Изменение свойств чата",
      "parameters": {
        "path": [
          {
            "name": "id",
            "type": "integer",
            "required": true,
            "description": "ID чата"
          }
        ]
      },
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "is_favorite": "boolean",
          "notifications": "boolean",
          "index": "integer",
          "last_seen_message": "integer"
        }
      },
      "responses": {
        "200": {
          "description": "Успешно обновлено",
          "schema": {
            "is_favorite": "boolean",
            "notifications": "boolean",
            "index": "integer",
            "last_seen_message": "integer",
            "last_seen_message_uid": "string (uuid)"
          }
        },
        "400": {
          "description": "Ошибка валидации запроса"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Чат не найден"
        }
      }
    },
    {
      "id": "chat_list_delete",
      "method": "DELETE",
      "path": "/api/v1/chat/list/{id}/",
      "description": "Удаление чата со всеми сообщениями",
      "parameters": {
        "path": [
          {
            "name": "id",
            "type": "integer",
            "required": true
          }
        ]
      },
      "responses": {
        "204": {
          "description": "Успешно удалено"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Чат не найден"
        }
      }
    },
    {
      "id": "chat_list_clear",
      "method": "POST",
      "path": "/api/v1/chat/list/clear/{id}/",
      "description": "Очистка чата (удаление всех сообщений)",
      "parameters": {
        "path": [
          {
            "name": "id",
            "type": "integer",
            "required": true
          }
        ]
      },
      "responses": {
        "204": {
          "description": "Успешно очищено"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Чат не найден"
        }
      }
    },
    {
      "id": "chat_generate_invite",
      "method": "POST",
      "path": "/api/v1/chat/list/generate-invite/{chat_key}/",
      "description": "Генерация пригласительной ссылки для группы/канала",
      "notes": [
        "Доступно только владельцу",
        "Создает JWT-приглашение"
      ],
      "parameters": {
        "path": [
          {
            "name": "chat_key",
            "type": "string",
            "required": true
          }
        ]
      },
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "expires_in": "integer (секунды)"
        }
      },
      "responses": {
        "200": {
          "description": "Ссылка создана",
          "schema": {
            "chat_key": "string",
            "chat_type": "string",
            "invite_link": "string",
            "expires_at": "integer (timestamp)"
          }
        },
        "400": {
          "description": "Ошибка валидации"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        }
      }
    },
    {
      "id": "group_channel_get",
      "method": "GET",
      "path": "/api/v1/chat/list/groups_or_channels/{chat_key}/",
      "description": "Получение группы или канала по chat_key",
      "notes": [
        "Требуется аутентификация",
        "Публичные группы доступны всем авторизованным",
        "Приватные группы доступны только участникам"
      ],
      "parameters": {
        "path": [
          {
            "name": "chat_key",
            "type": "string",
            "required": true
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Успешный ответ",
          "schema": {
            "id": "integer",
            "chat": "object",
            "is_active": "boolean",
            "is_favorite": "boolean",
            "notifications": "boolean",
            "name": "string",
            "description": "string",
            "chat_type": "string (public-group, private-group, channel)",
            "participants": "array[object]",
            "created_at": "datetime",
            "updated_at": "datetime"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Группа/канал не найден"
        }
      }
    },
    {
      "id": "group_participants_list",
      "method": "GET",
      "path": "/api/v1/chat/list/groups_or_channels/{chat_key}/participants/",
      "description": "Получение списка участников группы/канала",
      "notes": [
        "Владелец группы всегда отображается первым",
        "Доступна фильтрация по имени",
        "Требуется аутентификация"
      ],
      "parameters": {
        "path": [
          {
            "name": "chat_key",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "ordering",
            "type": "string"
          },
          {
            "name": "page",
            "type": "integer"
          },
          {
            "name": "page_size",
            "type": "integer"
          },
          {
            "name": "search",
            "type": "string"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Список участников",
          "schema": {
            "count": "integer",
            "results": "array[GroupChannelParticipant]"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Группа/канал не найден"
        }
      }
    },
    {
      "id": "group_preview",
      "method": "GET",
      "path": "/api/v1/chat/list/groups_or_channels/preview",
      "description": "Превью группы/канала по invite-token",
      "parameters": {
        "query": [
          {
            "name": "token",
            "type": "string",
            "required": true,
            "description": "JWT token из пригласительной ссылки"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Превью группы/канала",
          "schema": {
            "name": "string",
            "description": "string",
            "participants_count": "integer",
            "avatar_webp": "string"
          }
        },
        "400": {
          "description": "Ошибка валидации"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "404": {
          "description": "Приглашение не найдено"
        },
        "410": {
          "description": "Срок действия приглашения истек"
        },
        "422": {
          "description": "Недействительный токен приглашения"
        }
      }
    },
    {
      "id": "message_files_legacy",
      "method": "GET",
      "path": "/api/v1/chat/message/file/{user_uid}/",
      "description": "!!! Не использовать. Легаси. Будет удален !!!",
      "deprecated": true,
      "parameters": {
        "path": [
          {
            "name": "user_uid",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "from_me",
            "type": "boolean"
          },
          {
            "name": "ordering",
            "type": "string"
          },
          {
            "name": "page",
            "type": "integer"
          },
          {
            "name": "page_size",
            "type": "integer"
          },
          {
            "name": "search",
            "type": "string"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Список файлов"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "404": {
          "description": "Не найдено"
        }
      }
    },
    {
      "id": "message_files",
      "method": "GET",
      "path": "/api/v1/chat/message/files/{user_uid}/",
      "description": "Получение списка файлов чата",
      "notes": [
        "Включает файлы из пересланных сообщений",
        "Требуется аутентификация",
        "Публичные группы доступны для превью"
      ],
      "parameters": {
        "path": [
          {
            "name": "user_uid",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "is_active",
            "type": "boolean"
          },
          {
            "name": "is_blocked",
            "type": "boolean"
          },
          {
            "name": "is_favorite",
            "type": "boolean"
          },
          {
            "name": "ordering",
            "type": "string"
          },
          {
            "name": "page",
            "type": "integer"
          },
          {
            "name": "page_size",
            "type": "integer"
          },
          {
            "name": "search",
            "type": "string",
            "description": "Фильтрация по MIME-типу"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Список файлов",
          "schema": {
            "count": "integer",
            "results": "array[GroupChannelFile]"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Не найдено"
        }
      }
    },
    {
      "id": "message_links",
      "method": "GET",
      "path": "/api/v1/chat/message/links/{user_uid}/",
      "description": "Получение списка ссылок из сообщений чата",
      "notes": [
        "Ограничение: только последние 500 сообщений",
        "Сортировка: новые ссылки вверху по created_at",
        "Требуется аутентификация"
      ],
      "parameters": {
        "path": [
          {
            "name": "user_uid",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "is_active",
            "type": "boolean"
          },
          {
            "name": "is_blocked",
            "type": "boolean"
          },
          {
            "name": "is_favorite",
            "type": "boolean"
          },
          {
            "name": "ordering",
            "type": "string"
          },
          {
            "name": "page",
            "type": "integer"
          },
          {
            "name": "page_size",
            "type": "integer"
          },
          {
            "name": "search",
            "type": "string"
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Список ссылок",
          "schema": {
            "count": "integer",
            "results": "array[MessageLink]"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "403": {
          "description": "Недостаточно прав"
        },
        "404": {
          "description": "Не найдено"
        }
      }
    },
    {
      "id": "message_text_list",
      "method": "GET",
      "path": "/api/v1/chat/message/text/{user_uid}/",
      "description": "Получение списка сообщений пользователя или чата",
      "notes": [
        "Доступен поиск по content",
        "Сортировка по created_at",
        "Требуется аутентификация"
      ],
      "parameters": {
        "path": [
          {
            "name": "user_uid",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "from_me",
            "type": "boolean",
            "description": "Исходящие сообщения"
          },
          {
            "name": "new",
            "type": "boolean"
          },
          {
            "name": "ordering",
            "type": "string"
          },
          {
            "name": "page",
            "type": "integer"
          },
          {
            "name": "page_size",
            "type": "integer"
          },
          {
            "name": "search",
            "type": "string"
          },
          {
            "name": "range_time_start_created",
            "type": "string",
            "description": "Сообщения созданные с..."
          },
          {
            "name": "range_time_end_created",
            "type": "string",
            "description": "Сообщения созданные до..."
          }
        ]
      },
      "responses": {
        "200": {
          "description": "Список сообщений",
          "schema": {
            "count": "integer",
            "results": "array[Message]"
          }
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        },
        "404": {
          "description": "Не найдено"
        },
        "414": {
          "description": "Размер query-параметра превышает лимит"
        }
      }
    },
    {
      "id": "message_text_search",
      "method": "POST",
      "path": "/api/v1/chat/message/text/{user_uid}/search",
      "description": "Поиск позиции сообщения в чате по content или id_or_uid",
      "notes": [
        "Поиск по content регистронезависимо по частичному совпадению",
        "Можно передать chat_page_size для учета пагинации"
      ],
      "parameters": {
        "path": [
          {
            "name": "user_uid",
            "type": "string",
            "required": true
          }
        ],
        "query": [
          {
            "name": "ordering",
            "type": "string",
            "description": "Поля сортировки списка сообщений"
          }
        ]
      },
      "request_body": {
        "content_type": "application/json",
        "schema": {
          "field": "string (id_or_uid или content)",
          "query": "string",
          "chat_page_size": "integer"
        }
      },
      "responses": {
        "200": {
          "description": "Позиция сообщения найдена",
          "schema": {
            "id": "integer",
            "uid": "string (uuid)",
            "page": "integer",
            "position": "integer"
          }
        },
        "400": {
          "description": "Ошибка валидации запроса"
        },
        "401": {
          "description": "Не предоставлены учетные данные"
        }
      }
    }
  ],
  "authentication": {
    "type": "Bearer Token",
    "header": "Authorization"
  },
  "common_http_codes": {
    "200": "OK - Успешный запрос",
    "204": "No Content - Успешно, нет содержимого",
    "400": "Bad Request - Ошибка валидации",
    "401": "Unauthorized - Требуется аутентификация",
    "403": "Forbidden - Недостаточно прав",
    "404": "Not Found - Ресурс не найден",
    "410": "Gone - Ресурс больше недоступен",
    "414": "URI Too Long - Query параметр слишком длинный",
    "422": "Unprocessable Entity - Неправильные данные"
  },
  "data_types": {
    "ChatListItem": {
      "id": "integer",
      "chat": "UserProfile",
      "is_favorite": "boolean",
      "notifications": "boolean",
      "new_message_count": "integer",
      "name": "string",
      "chat_type": "string",
      "chat_key": "string",
      "last_activity_at": "timestamp",
      "last_message": "MessagePreview"
    },
    "Message": {
      "id": "integer",
      "uid": "uuid",
      "from_user": "UserProfile",
      "to_user": "UserProfile",
      "content": "string",
      "files_list": "array[File]",
      "replied_messages": "array[Message]",
      "forwarded_messages": "array[Message]",
      "new": "boolean",
      "created_at": "timestamp",
      "updated_at": "timestamp"
    }
  }
}