{
  "api_version": "1.0",
  "api_type": "WebSocket",
  "base_path": "/ws/chat",
  "authentication": {
    "method": "Token-based",
    "options": [
      {
        "type": "Query Parameter",
        "format": "/ws/chat?authorization={{token}}"
      },
      {
        "type": "Header",
        "format": "Authorization: Token {{token}}"
      }
    ],
    "description": "Требуется актуальный токен пользователя"
  },
  "operations": [
    {
      "id": 1,
      "action": "_connect",
      "method": "SEND",
      "path": "/ws/chat::_connect",
      "title": "Подключение",
      "description": "Подключение происходит через авторизацию. Это может происходить двумя способами: через параметр или через заголовок",
      "parameters": [],
      "request_body": null,
      "responses": {
        "200": "Успешное подключение"
      }
    },
    {
      "id": 2,
      "action": "add_members_to_chat",
      "method": "SEND",
      "path": "/ws/chat::add_members_to_chat",
      "title": "Добавление пользователей в группу или канал",
      "description": "Позволяет владельцу добавить новых участников в существующую группу или канал. Только владелец имеет право добавлять участников. Добавляемые пользователи получают уведомление о вступлении в чат. Для новых участников автоматически запускается асинхронная синхронизация истории сообщений (по умолчанию последние 1000 сообщений).",
      "permissions": "owner",
      "parameters": [],
      "request_body": {
        "action": "add_members_to_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "uid_users_list": ["string"]
        }
      },
      "responses": {
        "200": {
          "action": "add_members_to_chat",
          "request_uid": "uuid",
          "status": "OK",
          "error": "string",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "added_users": [
              {
                "uid": "uuid",
                "full_name": "string"
              }
            ]
          }
        },
        "400": {
          "status": "error",
          "error": "string",
          "object": null
        }
      }
    },
    {
      "id": 3,
      "action": "change_status_read_message",
      "method": "SEND",
      "path": "/ws/chat::change_status_read_message",
      "title": "Изменение статуса прочтения сообщения",
      "description": "Отмечает сообщение как прочитанное получателем. Позволяет отслеживать статус доставки и прочтения сообщений в чате. Влияет только на собственные непрочитанные сообщения.",
      "parameters": [],
      "request_body": {
        "action": "change_status_read_message",
        "request_uid": "uuid",
        "object": {
          "uid": "string (message_uid)",
          "reader_uid": "string (user_uid)",
          "new_read_status": true,
          "chat_key": "string"
        }
      },
      "responses": {
        "200": {
          "action": "change_status_read_message",
          "status": "OK",
          "object": {
            "id": 0,
            "uid": "uuid",
            "from_user": "object",
            "to_user": "object",
            "new": true,
            "created_at": 0,
            "updated_at": 0,
            "chat_data": {
              "chat_key": "string",
              "chat_type": "string"
            },
            "reader_uid": "string"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 4,
      "action": "clear_group_messages",
      "method": "SEND",
      "path": "/ws/chat::clear_group_messages",
      "title": "Очистка всех сообщений группы/канала",
      "description": "Удаляет все сообщения группы/канала для ВСЕХ участников. Доступно только владельцу. Требуется подтверждение (confirm=true). Повторные запросы ограничены (rate limit) - не чаще одного раза в минуту.",
      "permissions": "owner",
      "rate_limit": "1 раз в минуту",
      "parameters": [],
      "request_body": {
        "action": "clear_group_messages",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "confirm": true
        }
      },
      "responses": {
        "200": {
          "action": "clear_group_messages",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "cleared_by": "uuid"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 5,
      "action": "create_chat",
      "method": "SEND",
      "path": "/ws/chat::create_chat",
      "title": "Создание группы или канала",
      "description": "Создает новую группу или канал с указанными параметрами и добавляет участников. Требуется авторизация. Создатель автоматически становится владельцем. После создания все участники получают уведомление о новом чате.",
      "parameters": [],
      "request_body": {
        "action": "create_chat",
        "request_uid": "uuid",
        "object": {
          "name": "string (1-100 символов)",
          "description": "string (до 250 символов, опционально)",
          "avatar": {
            "filename": "string",
            "data": "base64 (320x320px, JPEG/PNG/BMP, до 5МБ)"
          },
          "chat_type": "public-group | private-group | public-channel | private-channel",
          "uid_users_list": ["uuid"]
        }
      },
      "responses": {
        "200": {
          "action": "create_chat",
          "status": "OK",
          "object": {
            "created_by": "uuid",
            "owner_full_name": "string",
            "chat_key": "string",
            "chat_id": "string",
            "name": "string",
            "description": "string",
            "chat_type": "string",
            "avatar": {
              "filename": "string",
              "url": "string"
            },
            "added_users": [
              {
                "uid": "uuid",
                "full_name": "string"
              }
            ]
          }
        },
        "400": "error"
      }
    },
    {
      "id": 6,
      "action": "create_text_message",
      "method": "SEND",
      "path": "/ws/chat::create_text_message",
      "title": "Отправка сообщения в чат/группу/канал",
      "description": "Отправляет текстовое сообщение или файлы в существующий чат или группу/канал, либо создает новый приватный чат между пользователями. При отправке в чат между пользователями передается to_user_uid. При отправке в группу/канал передается chat_key. Поддерживает пересылку сообщений и вложения файлов. Одновременное использование forwarded_messages и files невозможно.",
      "parameters": [],
      "request_body": {
        "action": "create_text_message",
        "request_uid": "uuid",
        "object": {
          "to_user_uid": "uuid (для личных чатов)",
          "chat_key": "string (для групп/каналов)",
          "content": "string",
          "status": "publish",
          "files": [
            {
              "filename": "string",
              "data": "base64"
            }
          ],
          "replied_messages": ["uuid"],
          "forwarded_messages": ["uuid"]
        }
      },
      "responses": {
        "200": {
          "action": "create_text_message",
          "status": "OK",
          "object": {
            "id": 0,
            "uid": "uuid",
            "from_user": "object",
            "to_user": "object | null",
            "content": "string",
            "replied_messages": "array",
            "forwarded_messages": "array",
            "files_list": "array",
            "new": true,
            "created_at": 0,
            "updated_at": 0,
            "chat_id": "string",
            "chat_key": "string",
            "chat_type": "string",
            "message_rtc": "object"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 7,
      "action": "delete_chat",
      "method": "SEND",
      "path": "/ws/chat::delete_chat",
      "title": "Удаление чата или канала",
      "description": "Удаление чата для всех участников или канала владельцем. Только владелец канала может удалить канал. После удаления все участники получают уведомление о закрытии чата.",
      "permissions": "owner",
      "parameters": [],
      "request_body": {
        "action": "delete_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string"
        }
      },
      "responses": {
        "200": {
          "action": "delete_chat",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 8,
      "action": "delete_message",
      "method": "SEND",
      "path": "/ws/chat::delete_message",
      "title": "Удаление сообщения",
      "description": "Владелец группы может удалять любое сообщение как для себя, так и для всех в группе. Участник группы может удалить свои сообщения как для себя, так и для всех в группе. Участник группы может удалить чужие сообщения только для себя. Только владелец канала может удалять сообщения в канале.",
      "parameters": [],
      "request_body": {
        "action": "delete_message",
        "request_uid": "uuid",
        "object": {
          "uid": "string (message_uid)",
          "for_all": true,
          "chat_key": "string"
        }
      },
      "responses": {
        "200": {
          "action": "delete_message",
          "status": "OK",
          "object": {
            "id": 0,
            "uid": "uuid",
            "chat_id": 0,
            "from_user": "object",
            "to_user": "object"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 9,
      "action": "edit_chat",
      "method": "SEND",
      "path": "/ws/chat::edit_chat",
      "title": "Редактирование группы или канала",
      "description": "Позволяет владельцу редактировать параметры существующей группы или канала: название (1-100 символов), описание (до 250 символов), аватар, тип доступа. Только владелец имеет право изменять настройки чата.",
      "permissions": "owner",
      "parameters": [],
      "request_body": {
        "action": "edit_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "name": "string",
          "description": "string",
          "avatar": {
            "filename": "string",
            "data": "base64"
          },
          "chat_type": "string"
        }
      },
      "responses": {
        "200": {
          "action": "edit_chat",
          "status": "OK",
          "object": {
            "created_by": "uuid",
            "owner_full_name": "string",
            "chat_key": "string",
            "chat_id": "string",
            "name": "string",
            "description": "string",
            "chat_type": "string",
            "avatar": "object",
            "added_users": "array"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 10,
      "action": "get_status_list_chat",
      "method": "SEND",
      "path": "/ws/chat::get_status_list_chat",
      "title": "Получение списка статусов собственных чатов",
      "description": "Возвращает информацию о статусах всех пользователей в чатах, где участвует текущий пользователь. Включает статус online/offline и время последней активности участников.",
      "parameters": [],
      "request_body": {
        "action": "get_status_list_chat",
        "request_uid": "uuid"
      },
      "responses": {
        "200": {
          "action": "get_status_list_chat",
          "status": "OK",
          "object": {
            "is_online": true,
            "was_online_at": 0,
            "user": "object"
          }
        },
        "400": "error"
      }
    },
    {
      "id": 11,
      "action": "join_by_invite_link",
      "method": "SEND",
      "path": "/ws/chat::join_by_invite_link",
      "title": "Присоединение к чату по приглашению",
      "description": "Обработчик вступления в чат по инвайт-ссылке. После успешного присоединения инициатор получает обычный ответ. Остальные участники чата получают push-уведомление с action=member_added",
      "parameters": [],
      "request_body": {
        "action": "join_by_invite_link",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "token": "string"
        }
      },
      "responses": {
        "200": {
          "action": "join_by_invite_link",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "joined_user": {
              "uid": "uuid",
              "full_name": "string"
            }
          }
        },
        "400": "error"
      },
      "notification_to_others": {
        "action": "member_added",
        "status": "OK",
        "object": {
          "chat_key": "string",
          "chat_type": "string",
          "joined_user": "object"
        }
      }
    },
    {
      "id": 12,
      "action": "leave_chat",
      "method": "SEND",
      "path": "/ws/chat::leave_chat",
      "title": "Выход участника из группы/канала",
      "description": "Обычные участники могут покидать группу/канал. Владелец группы/канала не может покидать их без передачи прав другому участнику. После выхода участники получают уведомление об успешном выходе.",
      "restrictions": "Владелец не может выйти без передачи прав",
      "parameters": [],
      "request_body": {
        "action": "leave_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string"
        }
      },
      "responses": {
        "200": {
          "action": "leave_chat",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "left_user": {
              "uid": "uuid",
              "full_name": "string"
            }
          }
        },
        "400": "error"
      }
    },
    {
      "id": 13,
      "action": "remove_members_from_chat",
      "method": "SEND",
      "path": "/ws/chat::remove_members_from_chat",
      "title": "Удаление участников из группы/канала владельцем",
      "description": "Позволяет владельцу удалить участников из группы или канала. Только владелец имеет право удалять участников. Удаленные пользователи теряют доступ к группе/каналу. Участники получают уведомление об удалении.",
      "permissions": "owner",
      "parameters": [],
      "request_body": {
        "action": "remove_members_from_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "uid_users_list": ["uuid"]
        }
      },
      "responses": {
        "200": {
          "action": "remove_members_from_chat",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "remove_users": [
              {
                "uid": "uuid",
                "full_name": "string"
              }
            ]
          }
        },
        "400": "error"
      }
    },
    {
      "id": 14,
      "action": "self_join_chat",
      "method": "SEND",
      "path": "/ws/chat::self_join_chat",
      "title": "Самостоятельное вступление в открытую группу/публичный канал",
      "description": "Позволяет пользователю самому вступить в публичную группу или публичный канал, указав chat_key. Вступление в закрытые группы и приватные каналы запрещено.",
      "restrictions": "Только для публичных групп и каналов",
      "parameters": [],
      "request_body": {
        "action": "self_join_chat",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string"
        }
      },
      "responses": {
        "200": {
          "action": "join_by_invite_link",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "joined_user": {
              "uid": "uuid",
              "full_name": "string"
            }
          }
        },
        "400": "error"
      }
    },
    {
      "id": 15,
      "action": "transfer_owner",
      "method": "SEND",
      "path": "/ws/chat::transfer_owner",
      "title": "Передача прав владельца группы/канала другому участнику",
      "description": "Позволяет текущему владельцу группы или канала передать права владельца другому участнику, который состоит в этой группе/канале. Новый владелец получает уведомление о передаче прав (action=owner_transferred)",
      "permissions": "owner",
      "parameters": [],
      "request_body": {
        "action": "transfer_owner",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "new_owner_uid": "uuid"
        }
      },
      "responses": {
        "200": {
          "action": "transfer_owner",
          "status": "OK",
          "object": {
            "chat_key": "string",
            "chat_type": "string",
            "new_owner": {
              "uid": "uuid",
              "full_name": "string"
            }
          }
        },
        "400": "error"
      },
      "notification_to_new_owner": {
        "action": "owner_transferred",
        "status": "OK",
        "object": {
          "chat_key": "string",
          "chat_type": "string",
          "new_owner": "object"
        }
      }
    },
    {
      "id": 16,
      "action": "update_message",
      "method": "SEND",
      "path": "/ws/chat::update_message",
      "title": "Редактирование сообщения",
      "description": "Позволяет автору изменить содержимое ранее отправленного сообщения. Редактировать можно только собственные сообщения. Поддерживается изменение текста и замена файлов.",
      "parameters": [],
      "request_body": {
        "action": "update_message",
        "request_uid": "uuid",
        "object": {
          "chat_key": "string",
          "uid": "string (message_uid)",
          "content": "string",
          "status": "publish",
          "files": [
            {
              "filename": "string",
              "data": "base64"
            }
          ]
        }
      },
      "responses": {
        "200": {
          "action": "update_message",
          "status": "OK",
          "object": {
            "id": 0,
            "uid": "uuid",
            "from_user": "object",
            "to_user": "object",
            "content": "string",
            "replied_messages": "array",
            "forwarded_messages": "array",
            "files_list": "array",
            "new": true,
            "created_at": 0,
            "updated_at": 0,
            "chat_id": 0,
            "chat_key": "string",
            "chat_type": "string",
            "message_rtc": "object"
          }
        },
        "400": "error"
      }
    }
  ],
  "chat_types": {
    "public-group": "Открытая группа (может вступить любой)",
    "private-group": "Закрытая группа (требуется приглашение)",
    "public-channel": "Публичный канал (может вступить любой)",
    "private-channel": "Частный канал (требуется приглашение)"
  },
  "permissions": {
    "owner": "Только владелец чата",
    "any_user": "Любой авторизованный пользователь",
    "member": "Только участник чата"
  },
  "data_types": {
    "uuid": "Уникальный идентификатор (UUID v4)",
    "base64": "Данные в формате Base64",
    "unix_timestamp": "Unix timestamp в миллисекундах"
  }
}